# Leave USE_LLM=false to run fully offline with rule-based extraction.
USE_LLM=true
LLM_PROVIDER=openai          # openai | azure_openai | anthropic | ollama
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

OPENAI_API_KEY=

# Azure OpenAI (set LLM_PROVIDER=azure_openai and LLM_MODEL to your deployment name)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=2024-08-01-preview

MAX_FILE_SIZE_MB=5
LOG_LEVEL=INFO

# Scoring weights
WEIGHT_REQUIRED=0.55
WEIGHT_PREFERRED=0.15
WEIGHT_EXPERIENCE=0.20
WEIGHT_EDUCATION=0.10
